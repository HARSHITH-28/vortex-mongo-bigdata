# VORTEX // ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your production values

# 1. MongoDB Connection String
# For Local/Docker MongoDB:
MONGODB_URI=mongodb://localhost:27017

# For MongoDB Atlas (Free Cloud M0 Cluster or Dedicated):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/vortex_bigdata?retryWrites=true&w=majority

# 2. Database Name
DATABASE_NAME=vortex_bigdata

# 3. Server Settings
HOST=0.0.0.0
PORT=8080

# 4. Ingestion Settings
DEFAULT_STREAM_RATE_PER_SEC=250
ANOMALY_Z_SCORE_THRESHOLD=2.58
